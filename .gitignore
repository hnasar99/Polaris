# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# browser automation scratch profile
/.tmp-shots/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Midnight Compact compiler output.
# Track polaris-health/contract (and public/zk assets) so Vercel/git deploys
# can load real bindings. Keep bulky intermediate dirs local-only.
/midnight/generated/*/
!/midnight/generated/README.md
!/midnight/generated/polaris-health/
!/midnight/generated/polaris-health/**
/midnight/generated/polaris-health/keys/
/midnight/generated/polaris-health/zkir/
/midnight/generated/polaris-health/compiler/
/midnight/contracts/node_modules/
/midnight/contracts/src/managed/

# public/zk/*/keys and zkir are intentionally tracked (synced by npm run sync:zk)

# Supabase CLI scratch state
/supabase/.temp/
