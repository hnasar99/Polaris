# Supabase (anon/publishable key only — never put the service-role key in the client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Midnight DApp Connector network id for wallet.connect(networkId)
# Must match the wallet extension's active network: undeployed | preview | preprod | mainnet
NEXT_PUBLIC_MIDNIGHT_NETWORK=preprod

# Deployed polaris-health Compact contract address (hex). Optional if you deploy from the app.
NEXT_PUBLIC_POLARIS_CONTRACT_ADDRESS=

# Set true ONLY after `npm run compact` + `npm run sync:zk` and generated Contract exists.
NEXT_PUBLIC_POLARIS_BINDINGS_READY=false
