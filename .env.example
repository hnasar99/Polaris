# Supabase (anon/publishable key only — never put the service-role key in the client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Demo Midnight adapter (local evaluation for hackathon demos ONLY)
# Default/production path uses MidnightAdapter which throws until real bindings are wired.
NEXT_PUBLIC_ENABLE_DEMO_MIDNIGHT=false

# Midnight DApp Connector network id for wallet.connect(networkId)
# Must match the wallet extension's active network: undeployed | preview | preprod | mainnet
NEXT_PUBLIC_MIDNIGHT_NETWORK=preprod
